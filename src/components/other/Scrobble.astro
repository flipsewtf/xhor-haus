---
//ScrobbleBox.astro
import { IconHeadphones } from '@tabler/icons-astro';

interface Props {
    class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['listened', className]}>
    <IconHeadphones aria-hidden="true" />
    <a
        class="track"
        href="https://listenbrainz.org/user/flipse"
        aria-label="See my latest scrobbled songs on my ListenBrainz profile (opens in new tab)"
        target="_blank"
        rel="noopener noreferrer">
        Loading last played track…
    </a>
</div>

<style>
    .listened {
        margin-block-start: var(--space-md);
    }

    svg {
        height: 1.25rem;
        width: 1.25rem;
        vertical-align: bottom;
        margin-right: var(--space-sm);
        stroke-width: 1.75;
        stroke: var(--text);
        flex: none;
    }

    a.track {
        font-weight: 500;
        line-height: var(--leading-heading);
        font-family: var(--font-family--mono);
        color: var(--text-muted);
        font-size: var(--text-xs);
    }
    a.track:hover {
        color: var(--accent);
        text-decoration: underline;
    }
</style>

<script defer>
    // Scrobble (Listenbrainz)
    const fixEncoding = (s) =>
        new TextDecoder().decode(new Uint8Array([...s].map((c) => c.charCodeAt(0))));

    function truncateWords(text, maxWords) {
        const words = text.split(' ');
        if (words.length <= maxWords) {
            return text;
        }
        return words.slice(0, maxWords).join(' ') + '…';
    }

    document.addEventListener('astro:page-load', async () => {
        const trackLink = document.querySelector('.listened .track');
        if (!trackLink) return;

        try {
            const res = await fetch('https://api.listenbrainz.org/1/user/flipse/listens?count=1');
            const t = (await res.json()).payload.listens?.[0]?.track_metadata;
            if (t) {
                trackLink.textContent = truncateWords(`${t.track_name} — ${t.artist_name}`, 10);
            }
        } catch (e) {
            console.error('Failed to fetch ListenBrainz data:', e);
        }
    });
</script>
