---
//Footer.astro

import { IconTelescope } from '@tabler/icons-astro';
---

<footer>
    <div class="inner">
        <span class="copysign">&copy</span> 2026 Flipse H. Made in Denmark by <IconTelescope
            title="stargazing"
        /> and panicking.
    </div>
</footer>

<style>
    footer {
        background-image: repeating-linear-gradient(
            to left,
            var(--bg-lines) 0 3px,
            transparent 3px 5px
        );
        background-size: auto 1px;
        background-position: top;
        background-repeat: no-repeat;
        width: 100%;
    }
    .inner {
        font-family: var(--font-family--mono);
        color: var(--text-muted);
        font-size: 0.8125rem;
        font-weight: 500;
        text-align: center;
        background-color: var(--bg-alt);
        padding-block: var(--space-sm);
        width: calc(var(--layout-content));
        margin-inline: auto;
        padding-inline: var(--layout--content-padding);
        margin-top: var(--space-1px);
    }
    .copysign {
        font-size: var(--text-xl);
    }
    svg {
        height: 1rem;
        width: 1rem;
        stroke-width: 2;
        margin-bottom: -0.0625rem;
    }
</style>
