---
//Footer.astro

import { IconTelescope } from '@tabler/icons-astro';
---

<footer>
    <div>
        <span class="copysign">&copy</span> 2026 Flipse H. Made by <span
            role="img"
            aria-label="stargazing"
            title="stargazing"><IconTelescope /></span
        > and panic.
    </div>
    <div>
        <a href="/colophon"> Colophon</a> &middot; <a
            href="https://github.com/flipsewtf/xhor-haus"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub repo (opens in a new tab)">
            GitHub</a
        >
    </div>
</footer>

<style>
    footer {
        font-family: var(--font-family--mono);
        color: var(--text-muted);
        font-size: var(--text-xs);
        font-weight: 500;
        border-top: var(--space-1px) solid var(--bg-lines);
        padding-block-start: var(--space-md);
        margin-block-start: clamp(3rem, 10vw, 4.5rem);
        display: flex;
        gap: var(--space-sm);
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
    }
    .copysign {
        font-size: var(--text-xl);
    }
    svg {
        height: 1rem;
        width: 1rem;
        stroke-width: 2;
        margin-bottom: -0.125rem;
    }

    @media (min-width: 46rem) {
        footer {
            padding-inline: 0;
            flex-direction: row;
        }
    }
</style>
