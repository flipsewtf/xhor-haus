<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />

<title>Xhor.haus{title ? ` | ${title}` : ''}</title>

<script is:inline>
    (() => {
        const root = document.documentElement;
        const storageKey = 'theme-mode';
        const order = ['light', 'system', 'dark'];
        const mql = window.matchMedia('(prefers-color-scheme: dark)');
        const labels = { light: 'Light theme', system: 'System theme', dark: 'Dark theme' };

        let direction = 'forward';

        const getMode = () => {
            const stored = localStorage.getItem(storageKey);
            return order.includes(stored) ? stored : 'system';
        };

        const resolveTheme = (mode) => {
            if (mode === 'system') return mql.matches ? 'dark' : 'light';
            return mode;
        };

        const applyToRoot = (target, mode) => {
            const theme = resolveTheme(mode);
            target.setAttribute('data-theme', theme);
            target.setAttribute('data-theme-mode', mode);
            target.style.colorScheme = theme;
            target.dataset.ready = 'true';
        };

        const syncButtons = () => {
            const label = labels[getMode()];
            document.querySelectorAll('.theme-toggle').forEach((btn) => {
                btn.setAttribute('aria-label', label);
                btn.title = label;
            });
        };

        const switchMode = (mode) => {
            root.classList.add('no-transition');
            applyToRoot(root, mode);
            syncButtons();
            setTimeout(() => root.classList.remove('no-transition'), 50);
        };

        applyToRoot(root, getMode());

        document.addEventListener('astro:before-swap', (event) => {
            applyToRoot(event.newDocument.documentElement, getMode());
        });

        document.addEventListener('astro:page-load', syncButtons);

        document.addEventListener('click', (event) => {
            if (!event.target.closest('.theme-toggle')) return;

            const i = order.indexOf(getMode());

            if (i === 0) direction = 'forward';
            if (i === order.length - 1) direction = 'backward';

            const next = order[direction === 'forward' ? i + 1 : i - 1];
            localStorage.setItem(storageKey, next);
            switchMode(next);
        });

        mql.addEventListener('change', () => {
            if (getMode() === 'system') switchMode('system');
        });
    })();
</script>

<ClientRouter />

<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<link rel="canonical" href={canonicalURL} />

<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark light" />

<link rel="alternate" type="application/rss+xml" title="Xhor.haus RSS Feed" href="/rss.xml" />

{description && <meta name="description" content={description} />}

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={ogImage} />
