---
// Figure.astro
interface Props {
    src: string;
    alt: string;
    caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="image-wrapper">
    <img src={src} alt={alt} class="lbox" />
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
    figcaption {
        margin-top: var(--space-xs);
        font-size: var(--font-size-sm);
        color: var(--text-muted);
        text-align: center;
    }
</style>
