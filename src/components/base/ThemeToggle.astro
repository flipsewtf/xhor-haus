---
//ThemeToggle.astro
---

<button class="theme-toggle" type="button" aria-label="Toggle theme">
    <svg viewBox="0 0 32 32" aria-hidden="true" fill="currentColor">
        <path
            class="dark-side-path"
            d="M16 .5C7.4.5.5 7.4.5 16S7.4 31.5 16 31.5 31.5 24.6 31.5 16 24.6.5 16 .5zm0 28.1V3.4C23 3.4 28.6 9 28.6 16S23 28.6 16 28.6z">
        </path>
    </svg>
</button>

<style>
    button.theme-toggle {
        display: inline-flex;
        position: fixed;
        right: var(--layout-spacing);
        top: var(--space-lg);
        z-index: 1;
    }
    button.theme-toggle svg {
        fill: currentColor;
        stroke: none;
        width: 1.5rem;
        height: 1.5rem;
    }

    :global(html.no-transition *) {
        transition: none !important;
    }
    @media (min-width: 48rem) {
        button.theme-toggle {
            right: max(
                var(--layout-spacing),
                calc((100% - var(--layout-max)) / 2 + var(--layout-spacing))
            );
        }
    }
</style>
