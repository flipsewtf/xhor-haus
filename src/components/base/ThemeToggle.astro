---
//ThemeToggle.astro
---

<button class="theme-toggle" type="button" aria-label="Toggle theme" title="toggle theme">
    <svg class="sunglasses" aria-hidden="true"><use href="#sunglasses"></use></svg>
    <svg class="moon" aria-hidden="true"><use href="#moon"></use></svg>
</button>

<style>
    button.theme-toggle {
        display: inline-flex;
        position: absolute;
        right: var(--layout-spacing);
        top: var(--space-md);
        z-index: 1;
    }
    button.theme-toggle svg {
        display: none;
        fill: currentColor;
        stroke: none;
        width: 3rem;
        height: 3rem;
    }

    :global(html[data-theme='light']) svg.sunglasses {
        display: block;
    }

    :global(html[data-theme='dark']) svg.moon {
        display: block;
    }

    :global(html.no-transition *) {
        transition: none !important;
    }
    @media (min-width: 48rem) {
        button.theme-toggle {
            right: calc(50% - var(--layout-content) / 2 + var(--layout--content-padding));
        }
    }
</style>
