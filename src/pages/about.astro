---
//badges.astro
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExternalLink from '@/components/base/ExternalLink.astro';

const pageTitle = 'About';
const pageDescription = `Bio of Flipse`;
---

<BaseLayout hasOwnTitle={true} pageTitle={pageTitle} pageDescription={pageDescription}>
    <h1>Hey, so I'm Flipse, or whatever.</h1>
    <article class="prose flow">
        <p>
            <b>Just kidding, there's nothing nonchalant about me.</b> A late-30s nerd of music and [insert
            current obsession]. Disabled/retired, but occasionally doing NASA's <ExternalLink
                href="https://science.nasa.gov/citizen-science/"
                label="homework"
            /> and picking fights with quantum physics just for kicks. I will recite the entire script
            of the 1998 hit movie <em>Armageddon</em> if I like you. The 'tism is strong with this one.
        </p>
        <p>
            I right-clicked <em>view source</em> sometime around 1999 and got my own domain quickly after.
            I have after 15+ years of creating <ExternalLink
                href="https://mournstera.tumblr.com/"
                label="Tumblr"
            /> themes, left that behind. I am now here.
        </p>

        <p>
            I dig live music, D&amp;D, <dfn
                title="The smell of rain hitting warm ground, pavement, and asphalt">petrichor</dfn
            >, and desk setups. If you wanna check out my <em>own</em> setup, you can do so here on my
            <a class="prose-link" href="/uses"> /uses</a> page.
        </p>
    </article>
</BaseLayout>

<style>
    dfn {
        font-style: normal;
        cursor: help;
    }
</style>
