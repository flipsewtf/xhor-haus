---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const pageTitle = `Now`;

const entries = await getCollection('log');
const sortedEntries = entries.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout pageTitle={pageTitle}>
    {
        sortedEntries.map(async (entry) => {
            const { Content } = await render(entry);
            return (
                <article
                    class="log-entry"
                    aria-label={`Log entry from ${entry.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}`}>
                    <time datetime={entry.data.pubDate.toISOString()}>
                        {entry.data.pubDate.toLocaleDateString('en-GB', {
                            day: 'numeric',
                            month: 'short',
                            year: 'numeric',
                        })}
                    </time>
                    <div class="log-content flow">
                        <Content />
                    </div>
                </article>
            );
        })
    }
</BaseLayout>
<style>
    article.log-entry {
        padding-block: var(--space-xl);
        border-left: var(--space-1px) solid var(--border);
    }
    article.log-entry:first-of-type {
        padding-block-start: 0;
    }
    article.log-entry:last-of-type {
        padding-block-end: 0;
    }

    article.log-entry time {
        display: flex;
        gap: var(--space-lg);
        font-family: var(--font-family--mono);
        font-weight: 600;

        align-items: center;
        margin-bottom: var(--space-lg);
        font-size: var(--text-xs);
        text-transform: uppercase;
    }

    article.log-entry time::before {
        content: '';
        display: block;
        width: calc(var(--space-sm) + var(--space-2px));
        height: calc(var(--space-sm) + var(--space-2px));
        background-color: var(--bg);
        border-radius: var(--radius-full);
        border: var(--space-3px) solid var(--text-muted);
        margin-left: calc(-0.5 * calc(var(--space-sm) + var(--space-2px)));
    }

    .log-content {
        margin-inline: var(--space-lg);
    }

    :global(.log-music) {
        font-size: var(--text-xs);
        font-family: var(--font-family--mono);
        margin-bottom: var(--space-md);
    }
    :global(svg.log-icon) {
        height: 1.25rem;
        width: 1.25rem;
        stroke-width: 2;
        stroke: var(--accent);
        vertical-align: sub;
        margin-right: var(--space-xs);
    }
    :global(.log-music p) {
        display: inline;
    }
</style>
